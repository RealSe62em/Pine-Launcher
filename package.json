{
  "name": "glaunch",
  "productName": "Pine Launcher",
  "desktopName": "pine-launcher",
  "description": "A polished multi-instance Minecraft launcher with Modrinth and CurseForge integration",
  "version": "1.2.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "build:installer:x64": "electron-builder --config electron-builder.yml --publish never --win nsis --x64",
    "build:installer:arm64": "electron-builder --config electron-builder.yml --publish never --win nsis --arm64",
    "build:installer": "npm run build:installer:x64 && node scripts/preserve-update-feed.js x64 && npm run build:installer:arm64 && node scripts/preserve-update-feed.js arm64",
    "build:deb:x64": "electron-builder --config electron-builder.yml --publish never --linux deb --x64",
    "build:deb:arm64": "electron-builder --config electron-builder.yml --publish never --linux deb --arm64",
    "build:deb": "npm run build:deb:x64",
    "build:pacman:x64": "electron-builder --config electron-builder.yml --publish never --linux pacman --x64",
    "build:pacman": "npm run build:pacman:x64",
    "build:arch": "npm run build:pacman:x64",
    "build:all": "npm run build:installer && npm run build:deb:x64 && npm run build:deb:arm64 && npm run build:pacman:x64",
    "build": "npm run build:installer"
  },
  "author": "Pine Launcher",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "0.6.0",
    "electron-updater": "6.8.9",
    "minecraft-launcher-core": "3.18.2"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "request": "npm:@cypress/request@4.0.1",
    "uuid": "11.1.1",
    "adm-zip": "0.6.0",
    "form-data": "4.0.6",
    "qs": "6.15.2",
    "tough-cookie": "4.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
